#!/bin/sh
# AI 에이전트(Cursor, Claude Code 등)가 커밋 메시지에 덧붙이는 attribution 트레일러/푸터 제거.
# 새로운 형태의 도구 서명이 생기면 아래 두 패턴 중 알맞은 쪽에 추가한다.
COMMIT_MSG_FILE=$1

# 1단계: 키 형태 트레일러 제거 (Co-authored-by:, Claude-Session:, Generated-by: 등)
# 2단계: 키 이름이 바뀌어도 걸리도록 내용 기반 방어 (AI 도구 서명 URL·메일 주소·푸터 문구)
grep -viE '^(co-authored-by|claude-session|generated-(by|with)|x-claude[a-z-]*):' "$COMMIT_MSG_FILE" \
  | grep -viE 'claude\.ai/code|noreply@anthropic\.com|🤖 generated with' \
  > "${COMMIT_MSG_FILE}.tmp"
mv "${COMMIT_MSG_FILE}.tmp" "$COMMIT_MSG_FILE"
